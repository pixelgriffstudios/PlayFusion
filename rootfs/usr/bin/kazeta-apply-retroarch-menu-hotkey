#!/usr/bin/env bash
set -euo pipefail

root="${1:-${HOME:-}}"
[[ -n "$root" && -d "$root" ]] || exit 0

mapfile -d '' configs < <(
    find "$root" -maxdepth 6 -type f -name retroarch.cfg -print0 2>/dev/null
)
[[ ${#configs[@]} -gt 0 ]] || exit 0

set_value() {
    local config="$1"
    local key="$2"
    local value="$3"
    if grep -Eq "^[[:space:]]*${key}[[:space:]]*=" "$config"; then
        sed -Ei "s|^[[:space:]]*${key}[[:space:]]*=.*$|${key} = \"${value}\"|" "$config"
    else
        printf '\n%s = "%s"\n' "$key" "$value" >> "$config"
    fi
}

for config in "${configs[@]}"; do
    backup="${config}.before-playfusion-menu-hotkey"
    [[ -e "$backup" ]] || cp -a -- "$config" "$backup"
    # F1 remains a keyboard hotkey, so the controller's existing Guide/tiny
    # menu button from its autoconfiguration continues to work as well.
    set_value "$config" input_menu_toggle f1
done

printf 'Configured RetroArch F1 menu hotkey in %s file(s).\n' "${#configs[@]}"
