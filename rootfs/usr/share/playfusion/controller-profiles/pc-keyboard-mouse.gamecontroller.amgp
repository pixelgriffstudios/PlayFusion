<?xml version="1.0" encoding="UTF-8"?>
<gamecontroller configversion="19" appversion="3.6.1">
    <profilename>PlayFusion PC Keyboard and Mouse</profilename>
    <sets>
        <set index="1">
            <stick index="1">
                <stickbutton index="7"><slots><slot><code>0x41</code><mode>keyboard</mode></slot></slots></stickbutton>
                <stickbutton index="5"><slots><slot><code>0x53</code><mode>keyboard</mode></slot></slots></stickbutton>
                <stickbutton index="3"><slots><slot><code>0x44</code><mode>keyboard</mode></slot></slots></stickbutton>
                <stickbutton index="1"><slots><slot><code>0x57</code><mode>keyboard</mode></slot></slots></stickbutton>
            </stick>
            <stick index="2">
                <diagonalRange>65</diagonalRange>
                <stickbutton index="7"><mousespeedx>45</mousespeedx><mousespeedy>45</mousespeedy><slots><slot><code>3</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="5"><mousespeedx>45</mousespeedx><mousespeedy>45</mousespeedy><slots><slot><code>2</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="3"><mousespeedx>45</mousespeedx><mousespeedy>45</mousespeedy><slots><slot><code>4</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="1"><mousespeedx>45</mousespeedx><mousespeedy>45</mousespeedy><slots><slot><code>1</code><mode>mousemovement</mode></slot></slots></stickbutton>
            </stick>
            <dpad index="1">
                <dpadbutton index="8"><slots><slot><code>0x1000012</code><mode>keyboard</mode></slot></slots></dpadbutton>
                <dpadbutton index="4"><slots><slot><code>0x1000015</code><mode>keyboard</mode></slot></slots></dpadbutton>
                <dpadbutton index="2"><slots><slot><code>0x1000014</code><mode>keyboard</mode></slot></slots></dpadbutton>
                <dpadbutton index="1"><slots><slot><code>0x1000013</code><mode>keyboard</mode></slot></slots></dpadbutton>
            </dpad>
            <button index="1"><slots><slot><code>0x1000004</code><mode>keyboard</mode></slot></slots></button>
            <button index="2"><slots><slot><code>0x1000000</code><mode>keyboard</mode></slot></slots></button>
            <button index="3"><slots><slot><code>0x20</code><mode>keyboard</mode></slot></slots></button>
            <button index="4"><slots><slot><code>0x1000001</code><mode>keyboard</mode></slot></slots></button>
            <button index="6"><slots><slot><path>/usr/bin/playfusion-osk-toggle</path><mode>execute</mode></slot></slots></button>
            <button index="8"><slots><slot><code>0x1000004</code><mode>keyboard</mode></slot></slots></button>
            <button index="9"><slots><slot><code>1</code><mode>mousebutton</mode></slot></slots></button>
        </set>
    </sets>
</gamecontroller>
