<?xml version="1.0" encoding="UTF-8"?>
<gamecontroller configversion="19" appversion="3.6.1">
    <profilename>PlayFusion Android Touch Tap</profilename>
    <sets>
        <set index="1">
            <stick index="2">
                <diagonalRange>65</diagonalRange>
                <stickbutton index="7"><mousespeedx>24</mousespeedx><mousespeedy>24</mousespeedy><slots><slot><code>3</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="5"><mousespeedx>24</mousespeedx><mousespeedy>24</mousespeedy><slots><slot><code>2</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="3"><mousespeedx>24</mousespeedx><mousespeedy>24</mousespeedy><slots><slot><code>4</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="1"><mousespeedx>24</mousespeedx><mousespeedy>24</mousespeedy><slots><slot><code>1</code><mode>mousemovement</mode></slot></slots></stickbutton>
            </stick>
            <button index="1">
                <slots><slot><code>1</code><mode>mousebutton</mode></slot></slots>
            </button>
            <button index="2">
                <slots><slot><path>/usr/bin/playfusion-waydroid-exit</path><mode>execute</mode></slot></slots>
            </button>
        </set>
    </sets>
</gamecontroller>
