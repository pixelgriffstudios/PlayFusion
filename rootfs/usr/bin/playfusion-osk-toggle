#!/usr/bin/env bash

set -euo pipefail

export DISPLAY="${DISPLAY:-:0}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
pid_file="/run/user/$(id -u)/playfusion-onboard.pid"

stop_keyboard() {
    if [[ -f "$pid_file" ]]; then
        pid="$(cat "$pid_file" 2>/dev/null || true)"
        if [[ "$pid" =~ ^[0-9]+$ ]]; then
            kill "$pid" 2>/dev/null || true
        fi
        rm -f "$pid_file"
    fi
}

if [[ "${1:-}" == "--stop" ]]; then
    stop_keyboard
    exit 0
fi

if gdbus introspect --session \
    --dest org.onboard.Onboard \
    --object-path /org/onboard/Onboard/Keyboard >/dev/null 2>&1; then
    gdbus call --session \
        --dest org.onboard.Onboard \
        --object-path /org/onboard/Onboard/Keyboard \
        --method org.onboard.Onboard.Keyboard.ToggleVisible >/dev/null
    exit 0
fi

command -v onboard >/dev/null || exit 1
onboard --size=1100x360 --keep-aspect >/tmp/playfusion-onboard.log 2>&1 &
echo "$!" > "$pid_file"
